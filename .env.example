# Copy to .env for local testing. Never commit .env.
# Required for cloud discovery
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
TAVILY_API_KEY=
DISCORD_WEBHOOK_STATUS=

# Reserved for future authenticated local dashboard (not used in Phase 2)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Reserved for future local AI worker (not used in Phase 2)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_QUICK_MODEL=qwen3:1.7b
OLLAMA_QUICK_CONTEXT=4096
OLLAMA_QUICK_MAX_TOKENS=768
OLLAMA_QUICK_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=0
LOCAL_AI_REQUIRE_APPROVAL=true

# Reserved for later provider fallback (not yet implemented)
BRAVE_SEARCH_API_KEY=
